{
  "name": "paseo-defer",
  "type": "module",
  "version": "2.1.8",
  "license": "MIT",
  "description": "Defer messages to Paseo coding agents until a chosen time or usage-window reset.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomgrin10/paseo-defer.git"
  },
  "homepage": "https://github.com/tomgrin10/paseo-defer#readme",
  "bugs": "https://github.com/tomgrin10/paseo-defer/issues",
  "author": "Tom Gringauz",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "automation",
    "productivity"
  ],
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "docs/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "node check-bundles.mjs && node check-format.mjs && node check-engine.mjs && node check-daemon-auth.mjs && node check-composer.mjs && node check-handoff.mjs && node check-slash.mjs && node check-pill.mjs && node check-gitinstall.mjs && node check-teardown.mjs",
    "test": "npm run check",
    "verify": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@getpaseo/client": "0.8.0",
    "@getpaseo/plugin": "0.8.0",
    "@getpaseo/protocol": "0.8.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/react": "~19.2.0",
    "esbuild": "^0.28.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
